                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "phone-muted": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    ""
                ]
            },
            "scroll-step": 1,
            "on-click": "pavucontrol",
            "ignored-sinks": [
                "Easy Effects Sink"
            ]
        },
        "network": {
            "interface": "wlp2s0",
            "format": "{ifname}",
            "format-wifi": "{essid} ({signalStrength}%) ",
            "format-ethernet": "{ifname} ",
            "format-disconnected": "",
            "format-disconnected": " ",
            "tooltip-format": "{ifname} ",
            "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
            "tooltip-format-ethernet": "{ifname}  ",
            "tooltip-format-disconnected": "Disconnected ",
            "max-length": 50
        },
        "image": {
            "path": "~/dotfiles/fedora.ico",
            "size": 32,
            "interval": 5,
            "on-click": "wofi --show drun"
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": false,
            "on-click": "wlogout -b 4 -l /home/david/.config/wlogout/layout -C /home/david/.config/wlogout/style.css"
        },
        "cava": {
            "cava_config": "/home/david/dotfiles/.config/cava/waybar.conf",
