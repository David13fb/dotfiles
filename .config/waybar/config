[
    // --- MONITOR PRINCIPAL ---
    {
        "output": "eDP-1", // Reemplaza con el nombre de tu pantalla principal (ej. eDP-1)
        "layer": "top",
        "margin-top": 7,
        "height": 17,
        "modules-left": [
            "hyprland/workspaces",
            "custom/player"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "group/right"
        ],
        "group/right": {
            "orientation": "horizontal",
            "modules": [
                "backlight/slider",
                "pulseaudio",
                "network",
                "battery",
                "power-profiles-daemon",
                "custom/power"
            ]
        },
        "backlight/slider": {
            "min": 10,
            "max": 100,
            "orientation": "horizontal",
            "device": "intel_backlight"
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "tooltip-format": "Perfil de energía: {profile}\nDriver: {driver}",
            "tooltip": true,
            "format-icons": {
                "default": "",
                "performance": "",
                "balanced": "",
                "power-saver": ""
            }
        },
        "battery": {
            "format": "{capacity}% {icon} ",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "clock": {
            "interval": 60,
            "format": "{:%H:%M}",
            "max-length": 25
        },
        "backlight": {
            "device": "intel_backlight",
            "format": " {icon} ",
            "format-icons": [
                "",
                ""
            ]
        },
        "pulseaudio": {
            "format": " {icon} {volume}% ",
            "format-bluetooth": " {icon} {volume}% ",
            "format-muted": "  ",
            "format-icons": {
                "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
                "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "phone-muted": "",
                "portable": "",
                "car": "",
                "default": [
                    "",
                    ""
                ]
            },
            "scroll-step": 1,
            "on-click": "pavucontrol",
            "ignored-sinks": [
                "Easy Effects Sink"
            ]
        },
        "network": {
            "interface": "wlo1",
            "format": "{ifname}",
            "format-wifi": " ",
            "format-ethernet": "  ",
            "format-disconnected": "disc",
            "tooltip-format": "  ",
            "tooltip-format-wifi": " ",
            "tooltip-format-ethernet": "",
            "tooltip-format-disconnected": "disc",
            "max-length": 50
        },
        "custom/player": {
            "exec": "/home/david/dotfiles/.config/waybar/customModules/player.sh",
            "max-length": 30,
            "escape": true,
            "on-click": "flatpak run com.mastermindzh.tidal-hifi --show"
        },
        "custom/power": {
            "format": " ⏻",
            "tooltip": false,
            "on-click": "wlogout -b 4 -l /home/david/.config/wlogout/layout -C /home/david/.config/wlogout/style.css"
        },
        "hyprland/workspaces": {
            "format": "{name}",
            "format-icons": {
                "1": "",
                "2": "",
                "3": "",
                "4": "",
                "5": "",
                "active": "",
                "default": ""
            },
            "persistent-workspaces": {
                "*": 5,
                "HDMI-A-1": 3
            }
        }
    },
