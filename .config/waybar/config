                "▂",
                "▃",
                "▄",
                "▅",
                "▆",
                "▇",
                "█"
            ],
            "actions": {
                "on-click-right": "mode"
            }
        },

        "hyprland/workspaces": {
            "format": "{name}",
            "format-icons": {
                "1": "",
                "2": "",
                "3": "",
                "4": "",
                "5": "",
                "active": "",
                "default": ""
            },
            "persistent-workspaces": {
                "*": 5,
                "HDMI-A-1": 3
            }
        }
    }
]